{
  "name": "flight-booking-application",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "install:all": "pnpm install",
    "backend:install": "python -m pip install -r backend_api/requirements.txt",
    "backend:start": "python -m uvicorn backend_api.main:app --reload --port 8000",
    "frontend:start": "pnpm --dir frontend start",
    "dev": "pnpm frontend:start",
    "build": "pnpm --dir frontend build",
    "test": "pnpm --dir frontend typescript-check"
  },
  "devDependencies": {
    "sharp": "^0.34.4"
  }
}
